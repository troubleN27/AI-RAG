# ==========================================================
# Общие настройки
# ==========================================================
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_CHAT_ENABLED=true

# ==========================================================
# Аналитика
# ==========================================================
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=

# ==========================================================
# Доставка заявок (укажите через запятую активные приёмники)
# Возможные значения: telegram | email | sheets | turso | console
# ==========================================================
LEAD_SINKS=console

# --- Turso (libSQL) ---
# Схема лежит в migrations/0001_leads.sql, применить один раз:
#   turso db execute <файл> --url <url> --token <token>
#   или npx drizzle-kit, если предпочтёте ORM
# Токен выдаётся в консоли Turso и в Vercel это секрет.
# TURSO_DATABASE_URL=libsql://имя-базы-регион.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# ==========================================================
# Антиспам / лимиты
# ==========================================================
# Redis для распределённого rate limit (пусто = in-memory)
RATE_LIMIT_REDIS_URL=
# Секрет для капчи (опционально)
CAPTCHA_SECRET=

# ==========================================================
# Чат-ассистент
# ==========================================================
# stub | gemini | rag
CHAT_PROVIDER=stub

# --- Google Gemini ---
GEMINI_API_KEY=
# Доступные модели: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# --- Google Workspace: источник RAG-данных ---
# Service Account JSON
GOOGLE_SERVICE_ACCOUNT_FILE=
# ID папки Google Drive, в которой лежат RAG-документы (Google Docs)
RAG_DRIVE_FOLDER_ID=
# ID Google Sheets с расписанием
SCHEDULE_SPREADSHEET_ID=
# Имя листа в таблице (по умолчанию — "Schedule")
SCHEDULE_SHEET_NAME=Schedule
# TTL кеша Google-данных в миллисекундах (по умолчанию 60 секунд)
RAG_CACHE_TTL_MS=60000

# --- Внешний RAG-сервис (на будущее) ---
RAG_SERVICE_URL=
RAG_SERVICE_TOKEN=